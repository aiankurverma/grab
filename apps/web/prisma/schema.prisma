generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

enum Platform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  FACEBOOK
  X
  VIMEO
  SOUNDCLOUD
  REDDIT
  TWITCH
  DAILYMOTION
  PINTEREST
  UNKNOWN
}

enum Format {
  MP3
  MP4
}

enum JobStatus {
  QUEUED
  PROBING
  DOWNLOADING
  CONVERTING
  UPLOADING
  READY
  FAILED
  CANCELLED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  plan          Plan      @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  jobs      Job[]
  quotaLogs QuotaEvent[]

  @@index([plan])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String    @id @default(cuid())
  userId          String?
  url             String
  platform        Platform
  format          Format
  quality         String
  status          JobStatus @default(QUEUED)
  progress        Int       @default(0)
  failureCode     String?
  failureMessage  String?
  title           String?
  durationSeconds Int?
  uploader        String?
  thumbnailUrl    String?
  outputKey       String?
  outputUrl       String?
  outputSizeBytes BigInt?
  correlationId   String    @default(cuid())
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  events     DomainEvent[]
  enrichment JobEnrichment?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
  @@index([expiresAt])
}

model DomainEvent {
  id            String    @id
  type          String
  aggregateId   String
  jobId         String?
  version       Int       @default(1)
  payload       Json
  occurredAt    DateTime
  recordedAt    DateTime  @default(now())
  consumedAt    DateTime?
  attempts      Int       @default(0)
  lastError     String?
  correlationId String?
  causationId   String?

  job Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([consumedAt, recordedAt])
  @@index([type, occurredAt])
  @@index([jobId, occurredAt])
}

model JobEnrichment {
  jobId     String   @id
  title     String
  summary   String
  tags      String[]
  slug      String
  provider  String
  model     String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([slug])
}

model QuotaEvent {
  id          String   @id @default(cuid())
  userId      String?
  anonymousId String?
  day         DateTime @db.Date
  amount      Int      @default(1)
  reason      String
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@index([anonymousId, day])
}


model ConversionEvent {
  id                     String   @id @default(cuid())
  timestamp              DateTime @default(now())
  visitorHash            String   @db.VarChar(64)
  userAgent              String?  @db.Text
  originalUrl            String   @db.Text
  platform               String   @db.VarChar(50)
  format                 String   @db.VarChar(10)
  quality                String   @db.VarChar(20)
  title                  String?  @db.Text
  duration               Int?
  cloudinaryThumbnailUrl String?  @db.Text

  @@index([timestamp(sort: Desc)])
  @@index([platform])
  @@index([visitorHash])
}

model ActiveVisitor {
  id        String   @id
  lastSeen  DateTime @default(now())
  userAgent String?  @db.Text
  ipHash    String?  @db.VarChar(64)

  @@index([lastSeen])
}
