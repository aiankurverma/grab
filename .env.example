# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
INTERNAL_API_SECRET=replace-with-a-long-random-string
LOG_LEVEL=debug

# ── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://grabwave:grabwave@localhost:5432/grabwave?schema=public

# ── Redis (RQ command queue + rate limits only) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Internal web ↔ worker channel (events are persisted via this endpoint) ──
WEB_INTERNAL_URL=http://localhost:3000
EVENT_POLL_INTERVAL_MS=750

# ── Object storage (signed local files in dev, S3/R2 in production) ─────────
STORAGE_DRIVER=local
MEDIA_ROOT=/tmp/grabwave/media
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=grabwave
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=21600

# ── Job pipeline ────────────────────────────────────────────────────────────
WORKER_THREADS=2
WORKER_QUEUE=audio,video,ai
MAX_CONCURRENT_DOWNLOADS=6
MAX_CONCURRENT_VIDEO=2
MAX_DURATION_SECONDS=7200
MAX_FILE_SIZE_MB=2048
JOB_TIMEOUT_SECONDS=1800
QUEUE_DEPTH_LIMIT=200

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=replace-with-a-long-random-string
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# ── Abuse protection ────────────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RATE_LIMIT_ANON_PER_DAY=2
RATE_LIMIT_FREE_PER_DAY=5

# ── AI: Mercury (runtime) ───────────────────────────────────────────────────
AI_ENRICHMENT_ENABLED=false
INCEPTION_API_KEY=
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-3
AI_DAILY_TOKEN_BUDGET=2000000

# ── AI: Muse Spark (build-time only, not used at runtime) ───────────────────
MUSE_MODEL=muse-spark-1.3-contributor
META_MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=

# ── Optional / later ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
INLINE_JOBS=false
MAX_4K_FILE_SIZE_MB=8192
VIDEO_4K_JOB_TIMEOUT_SECONDS=14400
WORKER_QUEUES=audio,video,video_4k,ai